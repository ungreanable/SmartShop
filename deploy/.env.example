# Copy to .env and fill in. Never commit .env.

# Public host name (DNS A record must point to this server) and contact for Let's Encrypt.
DOMAIN=smartshop.example.com
ADMIN_EMAIL=admin@example.com

# Images: published ones (ghcr.io/<owner>) or built on this machine with scripts/build-images.sh (IMAGE_PREFIX=smartshop-local).
IMAGE_PREFIX=ghcr.io/smartshop-village
TAG=latest

# Trial run without LINE: APP_ENVIRONMENT=Staging and DEV_LOGIN_ENABLED=true show a "Dev login" button
# (anyone can sign in as anyone). Dev login never works when APP_ENVIRONMENT=Production. Keep the defaults for real use.
APP_ENVIRONMENT=Production
DEV_LOGIN_ENABLED=false

# Secrets: generate with `openssl rand -base64 48`
POSTGRES_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
JWT_SIGNING_KEY=change-me-to-a-long-random-string-at-least-32-bytes
MEDIA_SIGNING_KEY=change-me-to-another-long-random-string
# Credentials between the app and the built-in S3 storage (SeaweedFS); any random values.
STORAGE_ACCESS_KEY=smartshop
STORAGE_SECRET_KEY=change-me

# LINE Login channel (https://developers.line.biz) - Login + LIFF
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LIFF_ID=

# LINE Messaging API channel (Official Account) - MUST be under the same Provider as the Login channel.
# Webhook URL: https://<DOMAIN>/api/webhooks/line
LINE_MESSAGING_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MONTHLY_QUOTA=300
# "Add friend" link of the Official Account (https://lin.ee/...), shown when users have not added it yet.
LINE_ADD_FRIEND_URL=

# Your own LINE user id: becomes System Admin on first login (can create villages).
SYSTEM_ADMIN_LINE_USER_ID=

# Web Push (VAPID) keys - generate with: docker run --rm ghcr.io/<owner>/smartshop-api:latest vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional: PostgreSQL row-level security as an extra tenant isolation layer (applied by the migrator).
DATABASE_ROW_LEVEL_SECURITY=false

# Optional: Firebase service account JSON (one line) for push to the Android app.
FIREBASE_CREDENTIALS_JSON=

# Optional: automatic slip verification service (POST {reference, amount} -> {valid, amount, message}).
# Leave empty to let shops check slips themselves. AUTO_CONFIRM=true marks genuine slips as paid.
SLIP_VERIFIER_URL=
SLIP_VERIFIER_API_KEY=
SLIP_VERIFIER_AUTO_CONFIRM=false

# Optional: OpenTelemetry collector (see docker-compose.observability.yml)
OTEL_EXPORTER_OTLP_ENDPOINT=
