    "MonthlyQuota": 300,
    "QuotaReserveForHighPriority": 50
  },
  "WebPush": {
    "Subject": "mailto:admin@example.com",
    "PublicKey": "",
    "PrivateKey": ""
  },
  "Firebase": {
    "CredentialsJson": ""
  },
  "Storage": {
    "Provider": "FileSystem",
    "Bucket": "smartshop",
    "FileSystemRoot": "data/media"
  },
  "App": {
    "PublicUrl": "http://localhost:5080"
  }
}
