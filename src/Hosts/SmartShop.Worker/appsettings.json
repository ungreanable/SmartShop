{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Wolverine": "Warning"
    }
  },
  "Auth": {
    "Jwt": {
      "Issuer": "smartshop",
      "Audience": "smartshop"
    }
  },
  "Line": {
    "MessagingChannelAccessToken": "",
