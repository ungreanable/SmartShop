{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Line": {
      "ChannelId": "",
      "LiffId": ""
    },
    "DevLogin": {
      "Enabled": false
    }
  },
  "Line": {
    "AddFriendUrl": ""
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "api",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "http://api" }
        }
      }
    }
  }
}
