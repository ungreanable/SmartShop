@inherits LayoutComponentBase
@implements IDisposable
@inject PlantContext Plant
@inject AppState State

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Fixed="true" Class="border-b">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/" aria-label="@L["กลับโหมดลูกค้า", "Back to customer mode"]" />
        <MudText Typo="Typo.subtitle1">@L["ผู้ดูแล", "Admin"] · @Plant.Current?.PlantName</MudText>
    </MudAppBar>
    <ConnectionBanner />
    <MudMainContent Style="padding-top:48px">
        <AppGuard RequirePlantAdmin="true">
            @Body
        </AppGuard>
    </MudMainContent>
</MudLayout>

<nav class="ss-bottom-nav">
    <div class="ss-nav-inner">
        <NavLink href="/admin" Match="NavLinkMatch.All"><MudIcon Icon="@Icons.Material.Filled.Dashboard" />@L["ภาพรวม", "Overview"]</NavLink>
        <NavLink href="/admin/members">
            <MudIcon Icon="@Icons.Material.Filled.People" />@L["สมาชิก", "Members"]
            @if (State.PendingMembers is > 0 and var pending) { <span class="ss-nav-count" aria-label="@L[$"รออนุมัติ {pending} คน", $"{pending} waiting for approval"]">@(pending > 99 ? "99+" : pending)</span> }
        </NavLink>
        <NavLink href="/admin/applications"><MudIcon Icon="@Icons.Material.Filled.AddBusiness" />@L["คำขอร้าน", "Requests"]</NavLink>
        <NavLink href="/admin/shops"><MudIcon Icon="@Icons.Material.Filled.Store" />@L["ร้านค้า", "Shops"]</NavLink>
        <NavLink href="/admin/more"><MudIcon Icon="@Icons.Material.Filled.MoreHoriz" />@L["อื่นๆ", "More"]</NavLink>
    </div>
</nav>

@code {
    // Pending join requests on the "members" tab: people wait for this approval before they can order at all.
    protected override async Task OnInitializedAsync()
    {
        State.Changed += Refresh;
        await State.RefreshPendingMembersAsync();
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose() => State.Changed -= Refresh;
}
