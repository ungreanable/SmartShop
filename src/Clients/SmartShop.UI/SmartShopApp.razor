@implements IDisposable
@inject Session Session
@inject PlantContext Plant
@inject Realtime Realtime
@inject AppState State
@inject OrderAlarm Alarm
@inject ILoginLauncher Login
@inject Browser Browser
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject PendingJoin PendingJoin
@inject IPushRegistrar Push
@inject Api Api

<MudThemeProvider Theme="UiSetup.Theme" @bind-IsDarkMode="_dark" ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Small" CloseButton="true" />
<MudSnackbarProvider />

@if (!_ready)
{
    <div class="ss-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="ss-muted">SmartShop</MudText>
    </div>
}
else
{
    <Router AppAssembly="typeof(SmartShopApp).Assembly" AdditionalAssemblies="AdditionalAssemblies">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(BareLayout)">
                <div class="ss-center">
                    <MudIcon Icon="@Icons.Material.Outlined.Explore" Size="Size.Large" />
                    <MudText Typo="Typo.h6">@L["ไม่พบหน้านี้", "Page not found"]</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary">@L["กลับหน้าแรก", "Back home"]</MudButton>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

@code {
    [Parameter] public IEnumerable<System.Reflection.Assembly> AdditionalAssemblies { get; set; } = [];

    private bool _ready;
    private bool _dark;

    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        await Session.InitializeAsync();
        L.Changed += Refresh;
        Session.Changed += OnSessionChanged;
        Realtime.Notification += OnNotification;

        // Inside the LINE app (LIFF) sign in silently.
        if (!Session.IsAuthenticated)
        {
            try
            {
                var auto = await Login.TryAutoLoginAsync();
                if (auto is not null) await Session.SignInAsync(auto, await Browser.UserAgentLabelAsync());
            }
            catch (JSException) { }
        }

        if (Session.IsAuthenticated) await StartAsync();
        _ready = true;
    }

    private async Task StartAsync()
    {
        await Plant.LoadAsync(force: true);
        State.Attach();
        Alarm.Attach();
        await Realtime.StartAsync();
        if (Plant.PlantId is { } plantId) await Realtime.JoinPlantAsync(plantId);
        // Join every shop I work for, so new-order alarms ring anywhere in the app.
        foreach (var shop in Plant.MyShops) await Realtime.JoinShopAsync(shop.Id);
        await State.RefreshUnreadAsync();
        await ResumeJoinAsync();
        _ = RefreshPushAsync();
    }

    /// <summary>
    /// Permission granted but this device not registered (never pressed "enable", or the browser rotated its
    /// subscription): register it again silently. Never prompts; only runs when permission is already granted.
    /// </summary>
    private async Task RefreshPushAsync()
    {
        try
        {
            if (!await Push.IsSupportedAsync() || await Push.PermissionAsync() != "granted") return;
            var channels = await Api.Get<Channels>("api/notifications/channels", silent: true);
            if (channels is not { WebPushConfigured: true } && Push.Kind == "WebPush") return;
            if (await Push.SubscribeAsync(channels?.VapidPublicKey) is not { } sub) return;
            await Api.Post("api/notifications/devices", new { kind = Push.Kind, endpoint = sub.Endpoint, p256dh = sub.P256dh, auth = sub.Auth, label = sub.Label }, silent: true);
        }
        catch (Exception e) when (e is JSException or HttpRequestException or InvalidOperationException)
        {
            // Best effort: the profile page shows the push status and lets the user enable it by hand.
        }
    }

    /// <summary>Back to the join form when login started from a join link but LINE returned somewhere else.</summary>
    private async Task ResumeJoinAsync()
    {
        if (await PendingJoin.GetAsync() is not { } code) return;
        var here = Nav.ToBaseRelativePath(Nav.Uri);
        if (here.StartsWith("join/", StringComparison.OrdinalIgnoreCase) || here.StartsWith("consent", StringComparison.OrdinalIgnoreCase)) return;
        Nav.NavigateTo($"/join/{Uri.EscapeDataString(code)}", replace: true);
    }

    private async void OnSessionChanged()
    {
        if (Session.IsAuthenticated) await StartAsync();
        else
        {
            Plant.Reset();
            await Realtime.StopAsync();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void OnNotification(RealtimeNotification n)
    {
        if (n.Type is "order.new" or "order.reminder") return; // handled by the order alarm
        _ = InvokeAsync(() => Snackbar.Add($"{n.Title} · {n.Body}", n.Urgent ? Severity.Warning : Severity.Info, o =>
        {
            if (n.Link is null) return;
            o.Action = L["ดู", "View"];
            o.OnClick = _ =>
            {
                Nav.NavigateTo(n.Link);
                return Task.CompletedTask;
            };
        }));
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        L.Changed -= Refresh;
        Session.Changed -= OnSessionChanged;
        Realtime.Notification -= OnNotification;
    }
}
