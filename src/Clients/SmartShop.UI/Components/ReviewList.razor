@* Rating summary + review cards. The shop can reply once; a village admin can hide abusive reviews. *@
@inject Api Api
@inject IDialogService Dialogs

@if (_summary is null) { <Loading /> }
else
{
    <div class="d-flex align-center gap-4 mb-3">
        <MudText Typo="Typo.h3">@_summary.Average.ToString("0.0")</MudText>
        <div style="flex:1">
            <MudRating SelectedValue="@((int)Math.Round(_summary.Average))" ReadOnly="true" />
            <MudText Typo="Typo.caption" Class="ss-muted">@_summary.Count @L["รีวิว", "reviews"]</MudText>
        </div>
        <div style="min-width:140px">
            @for (var star = 5; star >= 1; star--)
            {
                var n = _summary.Distribution.GetValueOrDefault(star);
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.caption" Style="width:12px">@star</MudText>
                    <MudProgressLinear Value="@(_summary.Count == 0 ? 0 : n * 100.0 / _summary.Count)" Color="Color.Warning" Rounded="true" />
                </div>
            }
        </div>
    </div>
    @if (_summary.Reviews.Count == 0) { <EmptyState Title="@L["ยังไม่มีรีวิว", "No reviews yet"]" Icon="@Icons.Material.Outlined.StarOutline" /> }
    @foreach (var r in _summary.Reviews)
    {
        <MudPaper Outlined="true" Class="@($"pa-3 mb-2 ss-card {(r.Hidden ? "ss-muted" : "")}")">
            <div class="d-flex align-center gap-2">
                <MudAvatar Size="Size.Small">@if (r.CustomerPictureUrl is not null) { <MudImage Src="@r.CustomerPictureUrl" /> } else { @r.CustomerName[..1] }</MudAvatar>
                <MudText Typo="Typo.subtitle2">@r.CustomerName</MudText>
                @if (r.Hidden) { <MudChip T="string" Size="Size.Small" Color="Color.Default">@L["ซ่อนอยู่", "Hidden"]</MudChip> }
                <MudSpacer />
                <MudRating SelectedValue="r.Rating" ReadOnly="true" Size="Size.Small" />
            </div>
            @if (r.Comment is not null) { <MudText Typo="Typo.body2" Class="mt-1">@r.Comment</MudText> }
            @if (r.Reply is not null) { <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-2">🏪 @r.Reply</MudAlert> }
            <div class="d-flex align-center gap-2 mt-1">
                <MudText Typo="Typo.caption" Class="ss-muted">@Fmt.DateTime(r.CreatedAt)</MudText>
                <MudSpacer />
                @if (CanReply && r.Reply is null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Reply"
                               OnClick="@(() => ReplyAsync(r))">@L["ตอบกลับ", "Reply"]</MudButton>
                }
                @if (CanHide)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="@(r.Hidden ? Color.Default : Color.Error)"
                               OnClick="@(() => ToggleHiddenAsync(r))">@(r.Hidden ? L["แสดง", "Unhide"] : L["ซ่อน", "Hide"])</MudButton>
                }
            </div>
        </MudPaper>
    }
}

@code {
    [Parameter, EditorRequired] public Guid ShopId { get; set; }
    [Parameter] public bool CanReply { get; set; }
    [Parameter] public bool CanHide { get; set; }

    private ReviewSummary? _summary;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _summary = await Api.Get<ReviewSummary>($"api/shops/{ShopId}/reviews") ?? new ReviewSummary(0, 0, [], []);

    private async Task ReplyAsync(Review r)
    {
        var parameters = new DialogParameters<TextPromptDialog> { { x => x.Label, L["ข้อความตอบกลับ", "Your reply"] } };
        var result = await (await Dialogs.ShowAsync<TextPromptDialog>(r.CustomerName, parameters)).Result;
        if (result is { Canceled: false, Data: string reply } && await Api.Post($"api/merchant/reviews/{r.Id}/reply", new { reply }))
            await LoadAsync();
    }

    private async Task ToggleHiddenAsync(Review r)
    {
        if (await Api.Put($"api/plant/admin/reviews/{r.Id}/hidden", new { hidden = !r.Hidden }))
            await LoadAsync();
    }
}
