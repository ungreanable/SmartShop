@* Uploads one image (or PDF for slips) to /api/media and returns the media id.
    Shows the chosen file with a spinner, the current step and elapsed time while it uploads, a cancel button when it is
   slow, and the reason when it fails. *@
@inject Api Api
@inject ISnackbar Snackbar
@implements IDisposable

<div class="ss-uploader">
    <MudFileUpload T="IBrowserFile" @ref="_picker" FilesChanged="UploadAsync" Accept="@Accept" Disabled="_busy">
        <CustomContent Context="upload">
            @if (ChildContent is not null)
            {
                <span style="display:inline-block; cursor:pointer" @onclick="upload.OpenFilePickerAsync">@ChildContent</span>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddAPhoto" Disabled="_busy"
                           OnClick="upload.OpenFilePickerAsync">
                    @(_busy ? L["กำลังอัปโหลด...", "Uploading..."] : (Label ?? L["เลือกรูป", "Choose picture"]))
                </MudButton>
            }
        </CustomContent>
    </MudFileUpload>
    @if (_fileName is not null && (_busy || _error is not null))
    {
        <div class="ss-upload-status">
            @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" Style="width:16px;height:16px" /> }
            else { <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Small" /> }
            <span class="ss-upload-name">@_fileName</span>
            @if (_busy)
            {
                @* Where it is and for how long, so a slow upload does not look frozen; cancel gives the user a way out. *@
                <span class="ss-muted ss-nowrap">@StageText@(_elapsed >= 3 ? $" {_elapsed} {L["วิ", "s"]}" : "")</span>
                @if (_elapsed >= 5)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="Cancel">@L["ยกเลิก", "Cancel"]</MudButton>
                }
            }
        </div>
        @if (_error is not null) { <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">@_error</MudText> }
    }
</div>

@code {
    private const long MaxImageBytes = 15 * 1024 * 1024;
    private const long MaxPdfBytes = 5 * 1024 * 1024;

    [Parameter, EditorRequired] public string Purpose { get; set; } = "";
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool AllowPdf { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<UploadResult> Uploaded { get; set; }
    /// <summary>True while a file is being uploaded: bind it to keep the form's save button disabled until it finishes.</summary>
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }

    // Photos are shrunk on the device first: a 12 MP phone photo (5-10 MB) becomes a few hundred KB, which uploads in
    // seconds on a mobile connection. The server keeps at most 2400 px anyway (ImageProcessor.OriginalMax).
    private const int ResizeTo = 2400;
    private const long ResizeAbove = 1024 * 1024;

    // Each step has its own limit: a browser that never finishes shrinking or reading a file (seen in the LINE in-app
    // browser) or a stalled mobile connection must end in a message, never in a spinner that turns forever.
    private static readonly TimeSpan ShrinkLimit = TimeSpan.FromSeconds(15);
    private static readonly TimeSpan ReadLimit = TimeSpan.FromSeconds(30);
    private static readonly TimeSpan UploadLimit = TimeSpan.FromSeconds(90);

    private enum Stage { Preparing, Uploading }

    private MudFileUpload<IBrowserFile>? _picker;
    private CancellationTokenSource? _cancel;
    private System.Threading.Timer? _ticker;
    private Stage _stage;
    private int _elapsed;
    private bool _busy;
    private string? _fileName, _error;

    private string StageText => _stage == Stage.Preparing ? L["กำลังเตรียมรูป…", "Preparing…"] : L["กำลังอัปโหลด…", "Uploading…"];
    private string Accept => AllowPdf ? "image/*,application/pdf" : "image/*";

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null) return;
        (_fileName, _error) = (file.Name, null);

        // Check on the device first: no point sending 30 MB just to be told it is too big.
        var isPdf = file.ContentType == "application/pdf";
        if (file.Size > (isPdf ? MaxPdfBytes : MaxImageBytes))
        {
            Fail(isPdf ? L["ไฟล์ PDF ต้องไม่เกิน 5 MB", "PDF files must be 5 MB or smaller"] : L["รูปต้องไม่เกิน 15 MB", "Pictures must be 15 MB or smaller"]);
            return;
        }

        await SetBusyAsync(true);
        _cancel = new CancellationTokenSource();
        StartTicker();
        var step = "read";
        try
        {
            _stage = Stage.Preparing;
            file = await ShrinkAsync(file);

            byte[] content;
            using (var readLimit = CancellationTokenSource.CreateLinkedTokenSource(_cancel.Token))
            {
                readLimit.CancelAfter(ReadLimit);
                content = new byte[file.Size];
                await using var stream = file.OpenReadStream(MaxImageBytes, readLimit.Token);
                await stream.ReadExactlyAsync(content, readLimit.Token);
            }

            step = "upload";
            _stage = Stage.Uploading;
            await InvokeAsync(StateHasChanged);
            using var uploadLimit = CancellationTokenSource.CreateLinkedTokenSource(_cancel.Token);
            uploadLimit.CancelAfter(UploadLimit);
            var (result, problem) = await Api.UploadAsync(content, file.Name, file.ContentType, Purpose, uploadLimit.Token);
            if (result is not null)
            {
                _fileName = null;
                await Uploaded.InvokeAsync(result);
            }
            else if (problem is not null && problem.Status != 401) Fail(Explain(problem));
        }
        catch (OperationCanceledException) when (_cancel?.IsCancellationRequested == true)
        {
            (_fileName, _error) = (null, null); // the user pressed cancel: nothing to explain
        }
        catch (OperationCanceledException)
        {
            Fail(step == "read"
                ? L["อ่านรูปจากเครื่องไม่ทัน ลองเลือกรูปใหม่ หรือแคปหน้าจอรูปนั้นแล้วส่งแทน", "Reading the picture took too long. Choose it again, or send a screenshot of it."]
                : Explain(new ApiProblem(0, "timeout", "Timeout")));
        }
        catch (Exception e) when (e is IOException or Microsoft.JSInterop.JSException)
        {
            Fail(L["อ่านไฟล์จากเครื่องไม่ได้ ลองเลือกใหม่อีกครั้ง", "Could not read the file from your device. Please choose it again."]);
        }
        finally
        {
            StopTicker();
            _cancel?.Dispose();
            _cancel = null;
            // Lets the same file be chosen again right away (a file input ignores re-picking an unchanged value).
            if (_picker is not null) await _picker.ClearAsync();
            await SetBusyAsync(false);
        }
    }

    private void Cancel() => _cancel?.Cancel();

    private void StartTicker()
    {
        _elapsed = 0;
        _ticker = new System.Threading.Timer(_ =>
        {
            _elapsed++;
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopTicker()
    {
        _ticker?.Dispose();
        _ticker = null;
    }

    public void Dispose()
    {
        StopTicker();
        _cancel?.Cancel();
        _cancel?.Dispose();
    }

    private async Task SetBusyAsync(bool busy)
    {
        _busy = busy;
        if (BusyChanged.HasDelegate) await BusyChanged.InvokeAsync(busy);
    }

    /// <summary>Large photos are scaled down in the browser (which also applies the camera's rotation); GIF and PDF are sent as they are.</summary>
    /// <remarks>Shrinking is only an optimisation: if the browser takes too long or fails, the original is sent instead.</remarks>
    private static async Task<IBrowserFile> ShrinkAsync(IBrowserFile file)
    {
        if (file.Size <= ResizeAbove || file.ContentType is not ("image/jpeg" or "image/png" or "image/webp")) return file;
        try
        {
            var smaller = await file.RequestImageFileAsync("image/jpeg", ResizeTo, ResizeTo).AsTask().WaitAsync(ShrinkLimit);
            return smaller.Size > 0 && smaller.Size < file.Size ? smaller : file;
        }
        catch (Exception e) when (e is Microsoft.JSInterop.JSException or InvalidOperationException or TimeoutException)
        {
            return file; // the browser could not decode it in time (e.g. HEIC on a PC): send the original, let the server explain
        }
    }

    private void Fail(string message)
    {
        _error = message;
        Snackbar.Add(message, Severity.Warning);
    }

    // The status code is shown so a failure reported by a user can be traced (nginx, Cloudflare or the app).
    private string Explain(ApiProblem p) => $"{Reason(p)} ({L["รหัส", "code"]} {(p.Status == 0 ? "network" : p.Status.ToString())})";

    private string Reason(ApiProblem p) => (p.Code, p.Status) switch
    {
        ("media_too_large", _) or (_, 413) => L["ไฟล์ใหญ่เกินไป (รูปไม่เกิน 15 MB, PDF ไม่เกิน 5 MB)", "The file is too large (pictures up to 15 MB, PDF up to 5 MB)"],
        ("media_type", _) => AllowPdf
            ? L["รองรับเฉพาะรูป JPEG, PNG, WebP, GIF หรือไฟล์ PDF", "Only JPEG, PNG, WebP, GIF pictures or PDF files"]
            : L["รองรับเฉพาะรูป JPEG, PNG, WebP, GIF (รูป HEIC ให้ตั้งกล้องเป็น JPEG หรือแคปหน้าจอแทน)", "Only JPEG, PNG, WebP or GIF pictures (for HEIC, switch the camera to JPEG or send a screenshot)"],
        ("media_corrupt", _) => L["อ่านรูปนี้ไม่ได้ ไฟล์อาจเสีย ลองเลือกรูปอื่น", "This picture could not be read; it may be damaged. Try another one."],
        ("media_empty", _) or ("media_incomplete", _) => L["อัปโหลดไม่ครบ ลองใหม่อีกครั้ง", "The upload did not complete. Please try again."],
        ("media_busy", _) => L["ระบบกำลังประมวลผลรูปอื่นอยู่ ลองใหม่อีกครั้งในไม่กี่วินาที", "Busy processing other pictures. Please try again in a few seconds."],
        ("storage_unavailable", _) => L["ที่เก็บไฟล์ของระบบยังไม่พร้อม ลองใหม่อีกครั้ง (ถ้ายังไม่ได้ แจ้งผู้ดูแลระบบ)", "File storage is not ready. Please try again (tell the administrator if it keeps failing)."],
        ("server_unavailable", _) or (_, 503) => L["ระบบกำลังรีสตาร์ตหรือไม่ว่าง ลองใหม่อีกครั้งในไม่กี่วินาที", "The server is restarting or busy. Please try again in a few seconds."],
        ("rate_limited", _) or (_, 429) => L["อัปโหลดถี่เกินไป รอสักครู่แล้วลองใหม่", "Too many uploads. Wait a moment and try again."],
        (_, >= 500) => L["ระบบขัดข้องระหว่างบันทึกรูป ลองใหม่อีกครั้ง (ถ้ายังไม่ได้ แจ้งผู้ดูแลระบบ)", "The server failed while saving the picture. Please try again (tell the administrator if it keeps failing)."],
        ("timeout", _) => L["อัปโหลดนานเกินไป สัญญาณอินเทอร์เน็ตอาจช้า ลองใหม่อีกครั้ง", "The upload took too long; the connection may be slow. Please try again."],
        ("network", _) or (_, 0) => L["เชื่อมต่อเซิร์ฟเวอร์ไม่ได้ ตรวจสอบอินเทอร์เน็ตแล้วลองใหม่", "Could not reach the server. Check your connection and try again."],
        _ => p.Message,
    };
}
