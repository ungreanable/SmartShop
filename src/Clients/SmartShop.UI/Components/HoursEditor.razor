@* Weekly opening hours: several slots per day (e.g. 06:00-09:00 and 16:00-19:00). Phone-first: one day per block. *@
@inject Api Api
@inject ISnackbar Snackbar

@foreach (var day in Days)
{
    var slots = _slots.Where(s => s.Day == day).ToList();
    <div class="ss-hours-day">
        <div class="d-flex align-center">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600; flex:1">@OpeningHoursView.DayName(day, L)</MudText>
            @if (slots.Count == 0) { <MudText Typo="Typo.body2" Class="ss-muted mr-2">@L["ปิด", "Closed"]</MudText> }
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Add(day))">
                @L["เพิ่มช่วง", "Add"]
            </MudButton>
        </div>
        @foreach (var slot in slots)
        {
            <div class="ss-hours-slot">
                <TimeField @bind-Value="slot.Open" Label="@L["เปิด", "Open"]" />
                <span class="ss-muted">–</span>
                <TimeField @bind-Value="slot.Close" Label="@L["ปิด", "Close"]" />
                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" OnClick="@(() => _slots.Remove(slot))" aria-label="@L["ลบช่วงเวลา", "Remove"]" />
            </div>
        }
    </div>
}
<div class="d-flex flex-wrap gap-2 mt-3 align-center">
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CopyMondayToWeekdays">@L["ใช้เวลาวันจันทร์กับ จ-ศ", "Copy Monday to weekdays"]</MudButton>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">@L["บันทึก", "Save"]</MudButton>
</div>

@code {
    [Parameter] public Guid ShopId { get; set; }
    [Parameter] public List<OpeningHour> Hours { get; set; } = [];

    private static readonly string[] Days = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private sealed class SlotForm
    {
        public string Day { get; set; } = "";
        public TimeSpan? Open { get; set; }
        public TimeSpan? Close { get; set; }
    }

    private List<SlotForm> _slots = [];

    protected override void OnParametersSet() =>
        _slots = Hours.Select(h => new SlotForm
        {
            Day = h.Day,
            Open = TimeSpan.Parse(h.OpenAt, System.Globalization.CultureInfo.InvariantCulture),
            Close = TimeSpan.Parse(h.CloseAt, System.Globalization.CultureInfo.InvariantCulture),
        }).ToList();

    private void Add(string day) => _slots.Add(new SlotForm { Day = day, Open = new TimeSpan(8, 0, 0), Close = new TimeSpan(17, 0, 0) });

    private void CopyMondayToWeekdays()
    {
        var monday = _slots.Where(s => s.Day == "Monday").ToList();
        _slots.RemoveAll(s => s.Day is "Tuesday" or "Wednesday" or "Thursday" or "Friday");
        foreach (var day in new[] { "Tuesday", "Wednesday", "Thursday", "Friday" })
            _slots.AddRange(monday.Select(m => new SlotForm { Day = day, Open = m.Open, Close = m.Close }));
    }

    private async Task SaveAsync()
    {
        var hours = _slots.Where(s => s.Open is not null && s.Close is not null)
            .Select(s => new { day = s.Day, openAt = s.Open!.Value.ToString(@"hh\:mm"), closeAt = s.Close!.Value.ToString(@"hh\:mm") }).ToList();
        if (await Api.Put($"api/merchant/shops/{ShopId}/hours", new { hours }))
            Snackbar.Add(L["บันทึกเวลาเปิด-ปิดแล้ว", "Opening hours saved"], Severity.Success);
    }
}
