@inject NavigationManager Nav

<MudPaper Class="@($"ss-card ss-shop-card mb-3 {(Shop.Status.AcceptingOrders ? "" : "ss-closed")}")" Elevation="0" Outlined="true"
          @onclick="@(() => Nav.NavigateTo($"/shops/{Shop.Id}"))">
    @if ((Shop.LogoUrl ?? Shop.CoverUrl) is not null)
    {
        <img class="ss-thumb" src="@(Shop.LogoUrl ?? Shop.CoverUrl)" alt="" loading="lazy" />
    }
    else
    {
        <div class="ss-thumb d-flex align-center justify-center"><MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" Color="Color.Primary" /></div>
    }
    <div style="min-width:0; flex:1" class="d-flex flex-column gap-1">
        <div class="d-flex align-center gap-1">
            <MudText Typo="Typo.subtitle1" Style="font-weight:600" Class="ss-clamp-2">@Shop.Name</MudText>
            @if (Shop.IsNew) { <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">@L["ใหม่", "New"]</MudChip> }
        </div>
        <StatusBadge Status="Shop.Status" AcceptsPreorders="Shop.AcceptsPreorders" />
        <MudText Typo="Typo.caption" Class="ss-muted">
            @if (Shop.RatingCount > 0) { <span>⭐ @Shop.RatingAverage.ToString("0.0") (@Shop.RatingCount) · </span> }
            @Shop.Category
            @if (!string.IsNullOrEmpty(Shop.HouseNo)) { <span> · @L["บ้าน", "House"] @Shop.HouseNo</span> }
        </MudText>
        <MudText Typo="Typo.caption" Class="ss-muted">
            @if (Shop.DeliveryEnabled) { <span>🛵 @L["ร้านส่ง", "Delivers"] </span> }
            @if (Shop.PickupEnabled) { <span>🏠 @L["รับที่ร้าน", "Pickup"] </span> }
            @if (Shop.PrepTimeMinutes > 0) { <span>· ~@Shop.PrepTimeMinutes @L["นาที", "min"]</span> }
        </MudText>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public ShopCard Shop { get; set; } = default!;
}
