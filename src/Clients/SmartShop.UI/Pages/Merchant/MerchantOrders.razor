@page "/merchant/{ShopId:guid}"
@layout MerchantLayout
@implements IDisposable
@inject Api Api
@inject Realtime Realtime
@inject OrderAlarm Alarm
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject PushPrompt PushPrompt
@inject Analytics Analytics

<div class="ss-page">
    @if (_settings is not null)
    {
        <MudPaper Class="pa-3 mb-3 ss-card" Outlined="true">
            @* Big open/closed switch on its own row; status and schedule underneath (fits phone width). *@
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight:700; flex:1">
                    @(_settings.Shop.Status.IsOpen() ? L["เปิดรับออเดอร์อยู่", "Accepting orders"] : L["ปิดรับออเดอร์", "Not accepting orders"])
                </MudText>
                <MudSwitch T="bool" Value="@_settings.Shop.Status.IsOpen()" ValueChanged="ToggleAsync" Color="Color.Success" Class="ss-big-switch"
                           aria-label="@L["เปิด/ปิดร้าน", "Open or close the shop"]" />
            </div>
            <div class="d-flex align-center gap-2 flex-wrap mt-1">
                <StatusBadge Status="_settings.Shop.Status" AcceptsPreorders="_settings.Shop.Status.AcceptsPreorders" />
                <MudText Typo="Typo.caption" Class="ss-muted">
                    @(_settings.OverrideMode switch { "ForceOpen" => L["เปิดเอง (ไม่ตามตารางเวลา)", "Manually open"], "ForceClosed" => L["ปิดเอง", "Manually closed"], _ => L["ตามตารางเวลา", "Following schedule"] })
                    @if (_settings.OverrideUntil is { } u) { <span class="ss-nowrap"> · @L["ถึง", "until"] @Fmt.DateTime(u)</span> }
                </MudText>
            </div>
            <div class="d-flex gap-2 mt-2 flex-wrap">
                @if (_settings.Shop.Status.State == "Busy")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => BusyAsync(0))">@L["เลิกยุ่ง รับออเดอร์ต่อ", "Resume orders"]</MudButton>
                }
                else if (_settings.Shop.Status.State == "Open")
                {
                    <MudMenu Label="@L["ยุ่ง หยุดรับชั่วคราว", "Busy, pause orders"]" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.HourglassTop">
                        @foreach (var m in new[] { 15, 30, 60 }) { <MudMenuItem OnClick="@(() => BusyAsync(m))">@m @L["นาที", "min"]</MudMenuItem> }
                    </MudMenu>
                }
                @if (_settings.OverrideMode != "None")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => StatusAsync("auto", null))">@L["กลับไปใช้ตารางเวลา", "Back to schedule"]</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Checklist" OnClick="PrepSummaryAsync">@L["สรุปของที่ต้องทำ", "To prepare"]</MudButton>
            </div>
            @if (_live > 0)
            {
                <MudText Typo="Typo.body2" Class="mt-1">👀 @L[$"กำลังดูร้านอยู่ {_live} คน", $"{_live} people viewing your shop"]</MudText>
            }
        </MudPaper>
    }

    <MudTabs @bind-ActivePanelIndex="_tab" MinimumTabWidth="0px" Class="ss-tabs-fill" Elevation="0" Color="Color.Transparent" SliderColor="Color.Primary" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L["ใหม่", "New"]" BadgeData="@Badge(_counts?.New)" BadgeColor="Color.Error" OnClick="@(() => LoadAsync(0))" />
        <MudTabPanel Text="@L["กำลังทำ", "Active"]" BadgeData="@Badge(_counts?.Active)" OnClick="@(() => LoadAsync(1))" />
        <MudTabPanel Text="@L["พร้อมส่ง", "Ready"]" BadgeData="@Badge(_counts?.Ready)" OnClick="@(() => LoadAsync(2))" />
        <MudTabPanel Text="@L["เสร็จแล้ว", "Done"]" OnClick="@(() => LoadAsync(3))" />
    </MudTabs>

    @* A failure must never look like "no new orders": the list stays as it was, with a retry row above it. *@
    @if (_problem is not null && _orders is not null) { <LoadError Inline="true" Problem="_problem" OnRetry="@(() => LoadAsync(_tab))" /> }
    @if (_orders is null && _problem is not null) { <LoadError Problem="_problem" OnRetry="@(() => LoadAsync(_tab))" /> }
    else if (_orders is null) { <Loading /> }
    else if (_orders.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Inbox" Title="@(_tab == 0 ? L["ยังไม่มีออเดอร์ใหม่", "No new orders"] : L["ไม่มีรายการ", "Nothing here"])" />
    }
    else
    {
        @foreach (var o in _orders)
        {
            var busy = _acting.Contains(o.Id);
            <MudPaper @key="o.Id" Outlined="true" Class="@($"pa-3 mb-2 ss-card {(o.Status == "PendingAcceptance" ? "ss-new-order" : "")}")">
                <div class="d-flex align-center" style="cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/merchant/{ShopId}/orders/{o.Id}"))">
                    <MudText Typo="Typo.h6" Style="font-weight:700">#@o.OrderNo</MudText>
                    <MudText Typo="Typo.caption" Class="ss-muted ms-2">@Fmt.Ago(o.PlacedAt, L)</MudText>
                    <MudSpacer />
                    @if (o.NeedsQuote && o.Status == "PendingAcceptance") { <MudChip T="string" Size="Size.Small" Color="Color.Warning">✍️ @L["รอใส่ราคา", "Needs prices"]</MudChip> }
                    else { <MudText Typo="Typo.subtitle1" Style="font-weight:700">@Fmt.Baht(o.Total)</MudText> }
                </div>
                <MudText Typo="Typo.body2">👤 @o.CustomerName @(o.CustomerHouseNo is null ? "" : $"· {L["บ้าน", "house"]} {o.CustomerHouseNo}")</MudText>
                <MudText Typo="Typo.body2">@(o.FulfillmentType == "Delivery" ? "🛵" : "🏠") @(o.ScheduledFrom is { } f && o.ScheduledTo is { } t ? Fmt.Window(f, t) : L["เร็วที่สุด", "ASAP"])</MudText>
                <MudText Typo="Typo.body2" Class="ss-clamp-2">🧾 @o.ItemsPreview</MudText>
                <div class="d-flex align-center gap-2 mt-1 flex-wrap">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@CartPage.PaymentIcon(o.PaymentMethodType) @OrderStatusChip.PaymentText(o.PaymentStatus, L)</MudChip>
                    @if (o.CancelRequested) { <MudChip T="string" Size="Size.Small" Color="Color.Error">@L["ขอยกเลิก", "Cancel requested"]</MudChip> }
                    @if (o.Status is not ("PendingAcceptance" or "Accepted" or "Preparing" or "Ready" or "OutForDelivery")) { <MudSpacer /><OrderStatusChip Status="@o.Status" /> }
                </div>
                @* One big next step per card (busy cards disabled: a double tap on a slow line must not act twice). Rejecting
                   is a small text link to the detail page, well away from "accept", where the reason is asked anyway. *@
                @switch (o.Status)
                {
                    case "PendingAcceptance" when o.NeedsQuote:
                        <MudButton Size="Size.Large" FullWidth="true" Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/merchant/{ShopId}/orders/{o.Id}")">✍️ @L["ใส่ราคา", "Set prices"]</MudButton>
                        break;
                    case "PendingAcceptance":
                        <MudButton Size="Size.Large" FullWidth="true" Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => ActAsync(o, "accept"))">
                            @(busy ? L["กำลังรับ...", "Accepting..."] : L["รับออเดอร์", "Accept"])
                        </MudButton>
                        <div class="d-flex justify-end mt-1">
                            <MudButton Variant="Variant.Text" Color="Color.Error" Disabled="busy" Href="@($"/merchant/{ShopId}/orders/{o.Id}")">@L["ปฏิเสธ...", "Reject..."]</MudButton>
                        </div>
                        break;
                    case "Accepted":
                        <MudButton Size="Size.Large" FullWidth="true" Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => ActAsync(o, "start"))">@L["เริ่มทำ", "Start"]</MudButton>
                        break;
                    case "Preparing":
                        <MudButton Size="Size.Large" FullWidth="true" Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Disabled="busy" OnClick="@(() => ActAsync(o, "ready"))">@L["พร้อมแล้ว", "Ready"]</MudButton>
                        break;
                    case "Ready" or "OutForDelivery":
                        <MudButton Size="Size.Large" FullWidth="true" Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" Href="@($"/merchant/{ShopId}/orders/{o.Id}")">@L["ส่งมอบ", "Hand over"]</MudButton>
                        break;
                }
            </MudPaper>
        }
    }
</div>

@code {
    [Parameter] public Guid ShopId { get; set; }

    private int _tab;
    private List<OrderSummary>? _orders;
    private OrderCounts? _counts;
    private ShopSettings? _settings;
    private static readonly string[] Tabs = ["new", "active", "ready", "done"];

    private static readonly TimeSpan Settle = TimeSpan.FromMilliseconds(400);
    private Reloader? _reload;
    // Status this device just set: the server's echo of it needs no second reload.
    private readonly Dictionary<Guid, string> _ownChanges = [];

    protected override async Task OnParametersSetAsync()
    {
        _reload ??= new Reloader(async () =>
        {
            await FetchAsync();
            StateHasChanged();
        });
        Realtime.NewOrder -= OnChanged;
        Realtime.OrderUpdated -= OnChanged;
        Realtime.Resynced -= OnResynced;
        Realtime.NewOrder += OnChanged;
        Realtime.OrderUpdated += OnChanged;
        Realtime.Resynced += OnResynced;
        StartLive();
        var settings = Api.Get<ShopSettings>($"api/merchant/shops/{ShopId}", silent: true);
        await Task.WhenAll(settings, LoadAsync(_tab));
        _settings = await settings ?? (_settings?.Shop.Id == ShopId ? _settings : null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Shop staff need alerts most: offer once on this page (our own explanation first, see PushPrompt).
        if (firstRender) await PushPrompt.OfferAsync(L["รับแจ้งเตือนเมื่อมีออเดอร์ใหม่ แม้ปิดหน้าเว็บอยู่", "Get new-order alerts even when this page is closed"]);
    }

    // People on the shop page right now (a count only). Polled, not pushed: cheap, and a minute late is fine.
    private static readonly TimeSpan LiveEvery = TimeSpan.FromSeconds(45);
    private Timer? _liveTimer;
    private Guid _liveShop;
    private int _live;

    private void StartLive()
    {
        if (_liveShop == ShopId && _liveTimer is not null) return;
        _liveShop = ShopId;
        _live = 0;
        _liveTimer?.Dispose();
        _liveTimer = new Timer(_ => _ = InvokeAsync(RefreshLiveAsync), null, TimeSpan.Zero, LiveEvery);
        _ = Analytics.WatchVisibilityAsync();
    }

    private async Task RefreshLiveAsync()
    {
        if (!Analytics.Visible) return;
        var shopId = ShopId;
        var count = await Analytics.LiveAsync(shopId) ?? 0;
        if (shopId != ShopId || count == _live) return;
        _live = count;
        StateHasChanged();
    }

    private static object? Badge(int? count) => count is > 0 ? count : null;

    private Task LoadAsync(int tab)
    {
        _tab = tab;
        return _reload!.RunNowAsync();
    }

    private async Task FetchAsync()
    {
        var (shopId, tab) = (ShopId, _tab);
        var orders = Api.Load<List<OrderSummary>>($"api/merchant/shops/{shopId}/orders?tab={Tabs[tab]}");
        var counts = Api.Get<OrderCounts>($"api/merchant/shops/{shopId}/orders/counts", silent: true);
        var list = await orders;
        var c = await counts;
        // Switched tab or shop meanwhile: the reload queued for the new one shows that instead.
        if (tab != _tab || shopId != ShopId) return;
        _problem = list.Problem;
        if (list.Failed)
        {
            // Keep the last list of this tab (never an empty "no new orders"); another tab's list would be wrong here.
            if (_loaded != (shopId, tab)) _orders = null;
            return;
        }
        (_orders, _loaded) = (list.Value ?? [], (shopId, tab));
        _counts = c ?? _counts;
    }

    private ApiProblem? _problem;
    private (Guid Shop, int Tab) _loaded = (Guid.Empty, -1);
    // Orders with a request in flight: their buttons stay disabled until the answer comes back.
    private readonly HashSet<Guid> _acting = [];

    private async Task ActAsync(OrderSummary o, string action)
    {
        if (!_acting.Add(o.Id)) return;
        try
        {
            if (await Api.Post<Order>($"api/merchant/orders/{o.Id}/{action}") is { } updated)
            {
                _ownChanges[o.Id] = updated.Status;
                await Alarm.Dismiss(o.Id); // stop ringing for this order on this device right away
                await LoadAsync(_tab);
            }
        }
        finally { _acting.Remove(o.Id); }
    }

    private async Task ToggleAsync(bool open)
    {
        if (open) await StatusAsync("open", null);
        else
        {
            var parameters = new DialogParameters<CloseShopDialog>();
            var result = await (await Dialogs.ShowAsync<CloseShopDialog>(L["ปิดร้าน", "Close the shop"], parameters)).Result;
            if (result is { Canceled: false }) await StatusAsync("close", result.Data as DateTimeOffset?);
        }
    }

    private async Task StatusAsync(string action, DateTimeOffset? until)
    {
        if (await Api.Post<ShopStatus>($"api/merchant/shops/{ShopId}/status", new { action, until }) is not null)
            _settings = await Api.Get<ShopSettings>($"api/merchant/shops/{ShopId}");
    }

    private async Task BusyAsync(int minutes)
    {
        if (await Api.Post<ShopStatus>($"api/merchant/shops/{ShopId}/busy", new { minutes }) is not null)
            _settings = await Api.Get<ShopSettings>($"api/merchant/shops/{ShopId}");
    }

    private async Task PrepSummaryAsync()
    {
        var items = await Api.Get<List<PrepItem>>($"api/merchant/shops/{ShopId}/orders/prep-summary") ?? [];
        var parameters = new DialogParameters<PrepSummaryDialog> { { x => x.Items, items } };
        await Dialogs.ShowAsync<PrepSummaryDialog>(L["สรุปของที่ต้องทำ", "To prepare"], parameters);
    }

    // Orders arrive in bursts (a lunch rush, or one change echoed to every staff phone): wait a moment and reload
    // once. Staff of several shops are in every shop's group, so skip events that name another shop.
    private void OnChanged(JsonElement e) => _ = InvokeAsync(() =>
    {
        if (e.TryGetProperty("shopId", out var shop) && shop.TryGetGuid(out var shopId) && shopId != ShopId) return;
        if (e.TryGetProperty("orderId", out var id) && id.TryGetGuid(out var orderId) && e.TryGetProperty("status", out var status)
            && _ownChanges.TryGetValue(orderId, out var mine) && mine == status.GetString())
        {
            _ownChanges.Remove(orderId); // the list was already reloaded right after this device made the change
            return;
        }
        _reload?.Schedule(Settle);
    });

    private void OnResynced() => _ = InvokeAsync(() => _reload?.Schedule(Settle));

    public void Dispose()
    {
        _liveTimer?.Dispose();
        Realtime.NewOrder -= OnChanged;
        Realtime.OrderUpdated -= OnChanged;
        Realtime.Resynced -= OnResynced;
        _reload?.Dispose();
    }
}
