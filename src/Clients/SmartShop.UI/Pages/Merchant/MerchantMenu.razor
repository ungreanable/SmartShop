@page "/merchant/{ShopId:guid}/menu"
@layout MerchantLayout
@inject Api Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@implements IDisposable

<div class="ss-page">
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.h5" Style="font-weight:700">@L["เมนู & สต็อก", "Menu & stock"]</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="@($"/merchant/{ShopId}/menu/new")">@L["เพิ่ม", "Add"]</MudButton>
    </div>

    <div class="ss-hscroll mb-2">
        @foreach (var f in Filters)
        {
            <MudChip T="string" Color="@(_filter == f.Key ? Color.Primary : Color.Default)" Variant="@(_filter == f.Key ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _filter = f.Key)">@f.Value</MudChip>
        }
    </div>

    @if (_items is not null && _problem is not null) { <LoadError Inline="true" Problem="_problem" OnRetry="LoadAsync" /> }
    @if (_items is null && _problem is not null) { <LoadError Problem="_problem" OnRetry="LoadAsync" /> }
    else if (_items is null) { <Loading /> }
    else if (_items.Count == 0)
    {
        <EmptyState Icon="@Icons.Material.Outlined.RestaurantMenu" Title="@L["ยังไม่มีสินค้า/บริการ", "No items yet"]">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/merchant/{ShopId}/menu/new")">@L["เพิ่มรายการแรก", "Add your first item"]</MudButton>
        </EmptyState>
    }
    else
    {
        @foreach (var m in Filtered)
        {
            var i = m.Item;
            @* The whole row opens the editor (a name link alone was a small target); the stock and switch controls
               stop the tap so using them never navigates away. *@
            <div @key="i.Id" class="ss-item ss-menu-row" @onclick="@(() => Nav.NavigateTo($"/merchant/{ShopId}/menu/{i.Id}"))">
                @if (i.ThumbnailUrl is not null) { <img class="ss-item-img" src="@i.ThumbnailUrl" alt="" style="width:64px;height:64px" /> }
                <div style="flex:1; min-width:0">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.subtitle1" Color="Color.Primary" Style="font-weight:600; flex:1; min-width:0">@i.Name</MudText>
                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="ss-muted" />
                    </div>
                    <MudText Typo="Typo.body2">@Fmt.Baht(i.Price) @(i.Kind == "Service" ? L["· บริการ", "· service"] : "")</MudText>
                    @if (!i.IsOrderable && m.IsAvailable) { <MudText Typo="Typo.caption" Class="ss-warn-text">@i.UnavailableReason</MudText> }
                    <div @onclick:stopPropagation="true">
                        @if (m.OnHand is { } onHand)
                        {
                            var left = onHand - (m.Reserved ?? 0);
                            <div class="d-flex align-center gap-1 flex-wrap mt-1">
                                <MudText Typo="Typo.body2" Class="me-1">@L["คงเหลือ", "In stock"]</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Variant="Variant.Outlined" Disabled="@(left <= 0)" OnClick="@(() => SetStockAsync(m, onHand - 1))"
                                               aria-label="@L[$"ลดสต็อก {i.Name} 1", $"Remove 1 {i.Name} from stock"]" />
                                <MudText Typo="Typo.h6" Style="min-width:40px; text-align:center">@left</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" OnClick="@(() => AddStockAsync(m, 1))"
                                               aria-label="@L[$"เพิ่มสต็อก {i.Name} 1", $"Add 1 {i.Name} to stock"]" />
                                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => RestockAsync(m))">@L["เติมหลายชิ้น", "Restock"]</MudButton>
                                @if (m.Reserved > 0) { <MudText Typo="Typo.caption" Class="ss-muted">(@L["จอง", "reserved"] @m.Reserved)</MudText> }
                            </div>
                        }
                        <div class="ss-menu-switches">
                            <div>
                                <MudSwitch T="bool" Value="m.IsAvailable" ValueChanged="@(v => AvailabilityAsync(m, v))" Color="Color.Success" Label="@L["เปิดขาย", "On sale"]" />
                                <MudText Typo="Typo.caption" Class="ss-muted d-block">@L["ปิด = ซ่อนจากลูกค้า", "Off = hidden from customers"]</MudText>
                            </div>
                            @if (i.StockMode == "Untracked")
                            {
                                <div>
                                    <MudSwitch T="bool" Value="m.IsSoldOut" ValueChanged="@(v => SoldOutAsync(m, v))" Color="Color.Error" Label="@L["ของหมด", "Sold out"]" />
                                    <MudText Typo="Typo.caption" Class="ss-muted d-block">@L["ลูกค้าเห็นแต่สั่งไม่ได้ จนกว่าจะปิดสวิตช์นี้", "Visible but cannot be ordered until you switch this off"]</MudText>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <MudExpansionPanels Elevation="0" Class="mt-4">
        <MudExpansionPanel Text="@L["หมวดหมู่ในร้าน", "Categories"]">
            @foreach (var c in _categories)
            {
                <div class="d-flex align-center">
                    <MudText>@c.Name</MudText>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => RenameCategoryAsync(c))" aria-label="@L[$"แก้ชื่อหมวด {c.Name}", $"Rename {c.Name}"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteCategoryAsync(c))" aria-label="@L[$"ลบหมวด {c.Name}", $"Delete {c.Name}"]" />
                </div>
            }
            <MudButton StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="AddCategoryAsync">@L["เพิ่มหมวดหมู่", "Add category"]</MudButton>
        </MudExpansionPanel>
        <MudExpansionPanel Text="@L["รอบสั่งล่วงหน้า / ซื้อกลุ่ม", "Pre-order rounds / group buys"]">
            <RoundsEditor ShopId="ShopId" />
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter] public Guid ShopId { get; set; }

    private List<MerchantItem>? _items;
    private ApiProblem? _problem;
    private List<Category> _categories = [];
    private string _filter = "all";

    private Dictionary<string, string> Filters => new()
    {
        ["all"] = L["ทั้งหมด", "All"],
        ["low"] = L["ใกล้หมด", "Low stock"],
        ["soldout"] = L["หมด", "Sold out"],
        ["off"] = L["ปิดขาย", "Off"],
    };

    private IEnumerable<MerchantItem> Filtered => _filter switch
    {
        "low" => _items!.Where(m => m.OnHand is { } h && h - (m.Reserved ?? 0) <= (m.LowStockThreshold ?? 5) && h - (m.Reserved ?? 0) > 0),
        "soldout" => _items!.Where(m => m.Item.UnavailableReason == "sold_out"),
        "off" => _items!.Where(m => !m.IsAvailable),
        _ => _items!,
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var items = Api.Load<List<MerchantItem>>($"api/merchant/shops/{ShopId}/catalog/items");
        var categories = Api.Get<List<Category>>($"api/merchant/shops/{ShopId}/catalog/categories", silent: true);
        var loaded = await items;
        _problem = loaded.Problem;
        // A failure is not "no items yet": that would invite the owner to add the whole menu again.
        if (!loaded.Failed) _items = loaded.Value ?? [];
        _categories = await categories ?? _categories;
    }

    private string Base(Guid itemId) => $"api/merchant/shops/{ShopId}/catalog/items/{itemId}";

    // Staff flip many switches in a row (closing time, sold-out rush). Show each change at once from what the API
    // answered, and refresh only the item list once they pause: the server works out the derived parts (e.g. why an
    // item cannot be ordered). Categories do not change here, so they are not fetched again.
    private Reloader? _refresh;

    private void Patch(MerchantItem m, Func<MerchantItem, MerchantItem> change)
    {
        var index = _items?.FindIndex(x => x.Item.Id == m.Item.Id) ?? -1;
        if (index >= 0) _items![index] = change(_items[index]);
        _refresh ??= new Reloader(async () =>
        {
            _items = await Api.Get<List<MerchantItem>>($"api/merchant/shops/{ShopId}/catalog/items", silent: true) ?? _items;
            StateHasChanged();
        });
        _refresh.Schedule(TimeSpan.FromSeconds(2));
    }

    public void Dispose() => _refresh?.Dispose();

    private async Task AvailabilityAsync(MerchantItem m, bool on)
    {
        if (await Api.Put($"{Base(m.Item.Id)}/availability", new { isAvailable = on })) Patch(m, x => x with { IsAvailable = on });
    }

    private async Task SoldOutAsync(MerchantItem m, bool soldOut)
    {
        if (await Api.Put($"{Base(m.Item.Id)}/sold-out", new { soldOut })) Patch(m, x => x with { IsSoldOut = soldOut });
    }

    private async Task SetStockAsync(MerchantItem m, int onHand)
    {
        if (await Api.Post<StockResult>($"{Base(m.Item.Id)}/stock", new { action = "set", quantity = onHand }) is { } stock)
            Patch(m, x => x with { OnHand = stock.OnHand, Reserved = stock.Reserved });
    }

    private async Task AddStockAsync(MerchantItem m, int quantity)
    {
        if (await Api.Post<StockResult>($"{Base(m.Item.Id)}/stock", new { action = "add", quantity }) is { } stock)
            Patch(m, x => x with { OnHand = stock.OnHand, Reserved = stock.Reserved });
    }

    private async Task RestockAsync(MerchantItem m)
    {
        var parameters = new DialogParameters<TextPromptDialog> { { x => x.Label, L["จำนวนที่เติม", "Quantity to add"] } };
        var result = await (await Dialogs.ShowAsync<TextPromptDialog>(m.Item.Name, parameters)).Result;
        if (result is { Canceled: false, Data: string text } && int.TryParse(text, out var qty) && qty > 0) await AddStockAsync(m, qty);
    }

    private async Task AddCategoryAsync()
    {
        var parameters = new DialogParameters<TextPromptDialog> { { x => x.Label, L["ชื่อหมวดหมู่", "Category name"] } };
        var result = await (await Dialogs.ShowAsync<TextPromptDialog>(L["เพิ่มหมวดหมู่", "Add category"], parameters)).Result;
        if (result is { Canceled: false, Data: string name } && await Api.Post($"api/merchant/shops/{ShopId}/catalog/categories", new { name })) await LoadAsync();
    }

    private async Task RenameCategoryAsync(Category c)
    {
        var parameters = new DialogParameters<TextPromptDialog> { { x => x.Label, L["ชื่อหมวดหมู่", "Category name"] }, { x => x.Initial, c.Name } };
        var result = await (await Dialogs.ShowAsync<TextPromptDialog>(L["แก้ไขหมวดหมู่", "Rename"], parameters)).Result;
        if (result is { Canceled: false, Data: string name } && await Api.Put($"api/merchant/shops/{ShopId}/catalog/categories/{c.Id}", new { name })) await LoadAsync();
    }

    private async Task DeleteCategoryAsync(Category c)
    {
        if (await Dialogs.ShowMessageBoxAsync(L["ลบหมวดหมู่?", "Delete category?"], c.Name, yesText: L["ลบ", "Delete"], cancelText: L["ยกเลิก", "Cancel"]) == true
            && await Api.Delete($"api/merchant/shops/{ShopId}/catalog/categories/{c.Id}")) await LoadAsync();
    }
}
