@page "/shops/{ShopId:guid}/reviews"
@inject PlantContext Plant

<div class="ss-page">
    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight:700">@L["รีวิวร้าน", "Shop reviews"]</MudText>
    <ReviewList ShopId="ShopId" CanHide="Plant.IsAdmin" />
</div>

@code {
    [Parameter] public Guid ShopId { get; set; }
}
