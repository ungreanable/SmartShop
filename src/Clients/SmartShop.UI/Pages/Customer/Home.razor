@page "/"
@implements IAsyncDisposable
@inject Api Api
@inject PlantContext Plant
@inject Realtime Realtime
@inject Browser Browser
@inject NavigationManager Nav

<div class="ss-page @(_cart?.ItemCount > 0 ? "ss-has-cart" : "")">
    <MudTextField T="string" @bind-Value="_q" Placeholder="@L["ค้นหาร้าน หรือเมนู...", "Search shops or dishes..."]" Variant="Variant.Outlined"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Class="mb-3"
                  OnKeyUp="@(e => { if (e.Key == "Enter") Search(); })" OnAdornmentClick="Search" />

    @foreach (var a in _announcements)
    {
        <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Campaign" Class="mb-2" Dense="true">
            <b>@a.Title</b>@if (!string.IsNullOrEmpty(a.Body)) { <span> · @a.Body</span> }
        </MudAlert>
    }

    @if (_home is null)
    {
        <Loading Rows="4" />
    }
    else if (_home.Total == 0 && _category is null)
    {
        <EmptyState Icon="@Icons.Material.Outlined.Storefront" Title="@L["ยังไม่มีร้านในหมู่บ้านนี้", "No shops in this village yet"]"
                    Text="@L["อยากเปิดร้านเองไหม? ส่งคำขอให้ผู้ดูแลหมู่บ้านได้เลย", "Want to open one? Send a request to the village admin."]">
            <MudButton Href="/shop-applications" Variant="Variant.Filled" Color="Color.Primary">@L["ขอเปิดร้าน", "Open a shop"]</MudButton>
        </EmptyState>
    }
    else
    {
        @if (_home.Categories.Count > 0)
        {
            <div class="ss-hscroll mb-2">
                <MudChip T="string" Color="@(_category is null ? Color.Primary : Color.Default)" Variant="@(_category is null ? Variant.Filled : Variant.Outlined)"
                         OnClick="@(() => FilterAsync(null))">@L["ทั้งหมด", "All"]</MudChip>
                @foreach (var c in _home.Categories)
                {
                    <MudChip T="string" Color="@(_category == c ? Color.Primary : Color.Default)" Variant="@(_category == c ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => FilterAsync(c))">@c</MudChip>
                }
            </div>
        }

        @* The server sends every open shop before the first closed one, so the open section is complete before "closed" starts. *@
        @if (_shops.Any(s => s.Status.AcceptingOrders))
        {
            <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight:700">🟢 @L["เปิดอยู่", "Open now"] <span class="ss-muted" style="font-weight:400">(@_home.OpenCount)</span></MudText>
            @foreach (var s in _shops.Where(s => s.Status.AcceptingOrders))
            {
                <ShopCardView @key="s.Id" Shop="s" />
            }
        }
        @if (_shops.Any(s => !s.Status.AcceptingOrders))
        {
            <MudText Typo="Typo.h6" Class="mb-2 mt-2" Style="font-weight:700">⚪ @L["ปิดอยู่", "Closed"]</MudText>
            @foreach (var s in _shops.Where(s => !s.Status.AcceptingOrders))
            {
                <ShopCardView @key="s.Id" Shop="s" />
            }
        }
        @if (_home.Total == 0)
        {
            <MudText Typo="Typo.body2" Class="ss-muted">@L["ไม่มีร้านในหมวดนี้", "No shops in this category"]</MudText>
        }

        @if (_loadingMore)
        {
            <Loading Rows="2" />
        }
        else if (_home.HasMore)
        {
            <div class="d-flex justify-center mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadMoreAsync">@L["โหลดเพิ่ม", "Load more"]</MudButton>
            </div>
        }
    }
    @* Always rendered, so the scroll observer is set up once and survives category changes. *@
    <div @ref="_listEnd" style="height:1px"></div>
</div>

@if (_cart?.ItemCount > 0)
{
    <div class="ss-cart-bar">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/cart" Style="border-radius:28px; justify-content:space-between; text-transform:none">
            <span>🛒 @_cart.ItemCount @L["รายการ", "items"] · @_cart.ShopName</span>
            <span>@Fmt.Baht(_cart.Subtotal)</span>
        </MudButton>
    </div>
}

@code {
    // A page is about one phone screen and a half of cards: small enough for a slow connection, big enough to scroll.
    private const int PageSize = 20;

    private HomeFeed? _home;
    private List<ShopCard> _shops = [];
    private int _pages;
    private int _generation; // bumped whenever the list is replaced, so a page fetched for the old list is dropped
    private bool _loadingMore;
    private bool _recheckEnd;
    private Cart? _cart;
    private List<Announcement> _announcements = [];
    private string? _category;
    private string? _q;

    private ElementReference _listEnd;
    private DotNetObjectReference<Home>? _self;
    private IJSObjectReference? _endObserver;

    private Reloader? _homeReload;
    private Reloader? _fullReload;

    protected override async Task OnInitializedAsync()
    {
        _homeReload = new Reloader(async () =>
        {
            await RefreshLoadedAsync();
            StateHasChanged();
        });
        _fullReload = new Reloader(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
        Realtime.ShopStatusChanged += OnShopChanged;
        Realtime.Resynced += OnResynced;
        Plant.Changed += OnPlantChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            _endObserver = await Browser.ObserveListEndAsync(_listEnd, _self);
        }
        // After a page arrives the end of a short list can still be on screen: ask the observer to report it again.
        if (_recheckEnd && _endObserver is not null && _home?.HasMore == true)
        {
            _recheckEnd = false;
            try { await _endObserver.InvokeVoidAsync("recheck"); }
            catch (JSException) { }
        }
    }

    private string HomeUrl(int page, int size) =>
        $"api/home?page={page}&size={size}{(_category is null ? "" : "&category=" + Uri.EscapeDataString(_category))}";

    private async Task LoadAsync()
    {
        var home = Api.Get<HomeFeed>(HomeUrl(1, PageSize));
        var cart = Api.Get<Cart>("api/cart", silent: true);
        var news = Api.Get<List<Announcement>>("api/plant/announcements", silent: true);
        Show(await home, 1);
        _cart = await cart;
        _announcements = await news ?? [];
    }

    private void Show(HomeFeed? home, int pages)
    {
        _home = home;
        _shops = home?.Shops ?? [];
        _pages = pages;
        _generation++;
        _recheckEnd = true;
    }

    [JSInvokable]
    public Task OnListEndVisible() => InvokeAsync(LoadMoreAsync);

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || _home is not { HasMore: true }) return;
        _loadingMore = true;
        StateHasChanged();
        var generation = _generation;
        var next = await Api.Get<HomeFeed>(HomeUrl(_pages + 1, PageSize));
        _loadingMore = false;
        // The list was replaced (category, village or a refresh) while this page was on its way: it belongs to the old list.
        if (next is not null && generation == _generation && _home is not null)
        {
            // A shop that opened or closed in between can shift by one place; never show it twice.
            var shown = _shops.Select(s => s.Id).ToHashSet();
            _shops = [.. _shops, .. next.Shops.Where(s => !shown.Contains(s.Id))];
            _home = next;
            _pages++;
            _recheckEnd = true;
        }
        StateHasChanged();
    }

    /// <summary>
    /// Re-fetches what is already on screen in one request (the server sorts its cached list and slices it, so the size does not
    /// add cache entries), so shops move between "open" and "closed" without losing the scroll position.
    /// </summary>
    private async Task RefreshLoadedAsync()
    {
        var pages = Math.Clamp(_pages, 1, 5);
        if (await Api.Get<HomeFeed>(HomeUrl(1, pages * PageSize), silent: true) is { } home) Show(home, pages);
    }

    private async Task FilterAsync(string? category)
    {
        _category = category;
        Show(null, 0);
        await LoadAsync();
    }

    private void Search()
    {
        if (!string.IsNullOrWhiteSpace(_q)) Nav.NavigateTo($"/search?q={Uri.EscapeDataString(_q)}");
    }

    // shop.status goes to the whole village: every open phone would reload at once when a shop opens, so wait a
    // random 1-4 s (several changes then share one reload) and fetch only the shop list, not the cart or news.
    private void OnShopChanged(JsonElement e)
    {
        // Filtered by category and that shop is not in the list: nothing on screen changes.
        if (_category is not null && _home is not null && e.TryGetProperty("shopId", out var id) && id.TryGetGuid(out var shopId)
            && !_shops.Any(s => s.Id == shopId)) return;
        _ = InvokeAsync(() => _homeReload?.ScheduleJittered(TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(4)));
    }

    private void OnResynced() => _ = InvokeAsync(() => _fullReload?.ScheduleJittered(TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(4)));

    private async void OnPlantChanged()
    {
        _category = null;
        Show(null, 0);
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Realtime.ShopStatusChanged -= OnShopChanged;
        Realtime.Resynced -= OnResynced;
        Plant.Changed -= OnPlantChanged;
        _homeReload?.Dispose();
        _fullReload?.Dispose();
        if (_endObserver is not null)
        {
            try
            {
                await _endObserver.InvokeVoidAsync("dispose");
                await _endObserver.DisposeAsync();
            }
            catch (JSDisconnectedException) { } // the mobile app's web view is already gone
            catch (JSException) { }
        }
        _self?.Dispose();
    }
}
