@page "/search"
@inject Api Api
@inject NavigationManager Nav

<div class="ss-page">
    <MudTextField T="string" @bind-Value="Q" Placeholder="@L["ค้นหาร้าน หรือเมนู...", "Search shops or dishes..."]" Variant="Variant.Outlined" Immediate="false"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Class="mb-3"
                  OnKeyUp="@(async e => { if (e.Key == "Enter") await SearchAsync(); })" OnAdornmentClick="SearchAsync" AutoFocus="true" />

    @if (_busy) { <Loading /> }
    else if (_result is not null)
    {
        @if (_result.Shops.Count == 0 && _result.Items.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.SearchOff" Title="@L["ไม่พบผลลัพธ์", "No results"]" />
        }
        @if (_result.Items.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight:600">@L["เมนู", "Dishes"]</MudText>
            @foreach (var i in _result.Items)
            {
                <div class="ss-item @(i.IsSoldOut ? "ss-unavailable" : "")" @onclick="@(() => Nav.NavigateTo($"/shops/{i.ShopId}"))">
                    @if (i.ThumbnailUrl is not null) { <img class="ss-item-img" src="@i.ThumbnailUrl" alt="" loading="lazy" /> }
                    <div>
                        <MudText Typo="Typo.subtitle2">@i.Name</MudText>
                        <MudText Typo="Typo.caption" Class="ss-muted">@i.ShopName</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@Fmt.Baht(i.Price) @(i.IsSoldOut ? L["· หมด", "· sold out"] : "")</MudText>
                    </div>
                </div>
            }
        }
        @if (_result.Shops.Count > 0)
        {
            <MudText Typo="Typo.subtitle1" Class="my-2" Style="font-weight:600">@L["ร้าน", "Shops"]</MudText>
            @foreach (var s in _result.Shops) { <ShopCardView Shop="s" /> }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private SearchResult? _result;
    private bool _busy;

    protected override async Task OnParametersSetAsync() => await SearchAsync();

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(Q)) return;
        _busy = true;
        _result = await Api.Get<SearchResult>($"api/search?q={Uri.EscapeDataString(Q)}");
        _busy = false;
    }
}
