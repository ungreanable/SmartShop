@page "/shop-invite/{Code}"
@inject Api Api
@inject PlantContext Plant
@inject Realtime Realtime
@inject NavigationManager Nav

<div class="ss-page">
    <div class="ss-center">
        <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Size="Size.Large" />
        @if (_accepted is null)
        {
            <MudText Typo="Typo.h6">@L["คำเชิญเข้าร่วมดูแลร้าน", "Shop team invitation"]</MudText>
            <MudText Class="ss-muted">@L["เมื่อยอมรับ คุณจะรับแจ้งเตือนออเดอร์และจัดการร้านได้ตามสิทธิ์ที่ได้รับ", "You will receive order alerts and manage the shop according to your role."]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="_busy" OnClick="AcceptAsync">@L["ยอมรับคำเชิญ", "Accept invitation"]</MudButton>
        }
        else
        {
            <MudText Typo="Typo.h6">@L[$"คุณเป็นสมาชิกร้าน {_accepted.ShopName} แล้ว", $"You joined {_accepted.ShopName}"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/merchant/{_accepted.ShopId}")">@L["ไปที่ร้าน", "Go to shop"]</MudButton>
        }
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";

    private AcceptedInvite? _accepted;
    private bool _busy;

    private async Task AcceptAsync()
    {
        _busy = true;
        _accepted = await Api.Post<AcceptedInvite>($"api/shop-invites/{Uri.EscapeDataString(Code)}/accept");
        if (_accepted is not null)
        {
            await Plant.LoadShopsAsync();
            await Realtime.JoinShopAsync(_accepted.ShopId);
        }
        _busy = false;
    }
}
