@page "/admin/shops"
@layout AdminLayout
@inject Api Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="ss-page">
    <div class="d-flex align-center mb-2">
        <MudText Typo="Typo.h5" Style="font-weight:700">@L["ร้านค้าในหมู่บ้าน", "Village shops"]</MudText>
        <MudSpacer />
        @if (_shops is { Count: > 1 } && _arranging is null)
        {
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.SwapVert"
                       OnClick="@(() => _arranging = [.. _shops])">@L["จัดลำดับร้าน", "Arrange"]</MudButton>
        }
    </div>
    @if (_shops is null) { <Loading /> }
    else if (_shops.Count == 0) { <EmptyState Title="@L["ยังไม่มีร้าน", "No shops yet"]" Icon="@Icons.Material.Outlined.Store" /> }
    else if (_arranging is not null)
    {
        @* Buttons rather than drag and drop: dragging is fiddly on small phones and inside the LINE browser. *@
        <MudText Typo="Typo.body2" Class="ss-muted mb-2">
            @L["ลำดับนี้ใช้ในหน้าแรกของลูกค้า (ร้านที่เปิดอยู่จะขึ้นก่อนร้านที่ปิดเสมอ) ร้านใหม่จะต่อท้ายจนกว่าจะจัดลำดับอีกครั้ง",
               "Customers see shops in this order on the home page (open shops always come before closed ones). New shops go to the end until you arrange again."]
        </MudText>
        @for (var i = 0; i < _arranging.Count; i++)
        {
            // Copy the loop variable: the click handlers run after the loop has finished.
            var index = i;
            var s = _arranging[index];
            <MudPaper @key="s.Id" Outlined="true" Class="pa-2 mb-1 ss-card d-flex align-center gap-1">
                <MudText Typo="Typo.body2" Class="ss-muted" Style="min-width:24px; text-align:right">@(index + 1).</MudText>
                <MudText Typo="Typo.subtitle2" Class="ss-ellipsis" Style="flex:1; min-width:0">@s.Name</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.VerticalAlignTop" Size="Size.Small" Disabled="@(index == 0)"
                               aria-label="@L["ไว้บนสุด", "Move to top"]" OnClick="@(() => Move(index, 0))" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(index == 0)"
                               aria-label="@L["ขึ้น", "Up"]" OnClick="@(() => Move(index, index - 1))" />
                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(index == _arranging.Count - 1)"
                               aria-label="@L["ลง", "Down"]" OnClick="@(() => Move(index, index + 1))" />
            </MudPaper>
        }
        <div class="d-flex justify-end gap-2 mt-3">
            <MudButton Variant="Variant.Text" OnClick="@(() => _arranging = null)">@L["ยกเลิก", "Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving" OnClick="SaveOrderAsync">@L["บันทึกลำดับ", "Save order"]</MudButton>
        </div>
    }
    else
    {
        @foreach (var s in _shops)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2 ss-card">
                <div class="d-flex align-center gap-2">
                    @if (s.LogoUrl is not null) { <MudAvatar><MudImage Src="@s.LogoUrl" /></MudAvatar> }
                    <div style="flex:1; min-width:0">
                        <MudLink Href="@($"/shops/{s.Id}")" Typo="Typo.subtitle1" Class="d-block ss-ellipsis" Style="font-weight:600">@s.Name</MudLink>
                        <MudText Typo="Typo.caption" Class="ss-muted d-block">
                            <span class="ss-nowrap">@L["รหัส", "Code"] @s.Code</span> · <span class="ss-nowrap">@s.MemberCount @L["สมาชิกร้าน", "team"]</span>
                            @if (s.RatingCount > 0) { <span class="ss-nowrap"> · ⭐ @s.RatingAverage.ToString("0.0") (@s.RatingCount)</span> }
                        </MudText>
                    </div>
                    <StatusBadge Status="s.Status" />
                </div>
                @if (s.Lifecycle == "Suspended")
                {
                    <div class="ss-suspended-box mt-2">
                        @if (!string.IsNullOrWhiteSpace(s.SuspendReason)) { <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">⛔ @s.SuspendReason</MudText> }
                        <MudSwitch T="bool" Value="s.VisibleWhileSuspended" ValueChanged="@(v => SetVisibleAsync(s, v))" Color="Color.Primary" Class="ma-0">
                            <MudText Typo="Typo.body2">@L["ลูกค้ายังเห็นร้าน (สั่งซื้อไม่ได้)", "Customers can still see the shop (no ordering)"]</MudText>
                        </MudSwitch>
                        <div class="d-flex justify-end">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => ReinstateAsync(s))">@L["คืนสถานะร้าน", "Reinstate"]</MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-end mt-1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => SuspendAsync(s))">@L["ระงับร้าน", "Suspend"]</MudButton>
                    </div>
                }
            </MudPaper>
        }
    }
</div>

@code {
    private List<AdminShopRow>? _shops;
    private List<AdminShopRow>? _arranging;
    private bool _saving;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _shops = await Api.Get<List<AdminShopRow>>("api/plant/admin/shops") ?? [];

    private void Move(int from, int to)
    {
        var shop = _arranging![from];
        _arranging.RemoveAt(from);
        _arranging.Insert(to, shop);
    }

    private async Task SaveOrderAsync()
    {
        _saving = true;
        if (await Api.Put("api/plant/admin/shops/order", new { shopIds = _arranging!.Select(s => s.Id).ToList() }))
        {
            Snackbar.Add(L["บันทึกลำดับร้านแล้ว", "Shop order saved"], Severity.Success);
            _arranging = null;
            await LoadAsync();
        }
        _saving = false;
    }

    private async Task SuspendAsync(AdminShopRow s)
    {
        var result = await (await Dialogs.ShowAsync<SuspendShopDialog>(L["ระงับร้าน", "Suspend"] + " " + s.Name)).Result;
        if (result is { Canceled: false, Data: SuspendShopResult r }
            && await Api.Post($"api/plant/admin/shops/{s.Id}/suspend", new { reason = r.Reason, visible = r.Visible }))
            await LoadAsync();
    }

    private async Task SetVisibleAsync(AdminShopRow s, bool visible)
    {
        if (await Api.Put($"api/plant/admin/shops/{s.Id}/suspension-visibility", new { visible })) await LoadAsync();
    }

    private async Task ReinstateAsync(AdminShopRow s)
    {
        if (await Api.Post($"api/plant/admin/shops/{s.Id}/reinstate", new { })) await LoadAsync();
    }
}
