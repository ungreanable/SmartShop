@page "/admin/shops"
@layout AdminLayout
@inject Api Api
@inject IDialogService Dialogs

<div class="ss-page">
    <MudText Typo="Typo.h5" Class="mb-2" Style="font-weight:700">@L["ร้านค้าในหมู่บ้าน", "Village shops"]</MudText>
    @if (_shops is null) { <Loading /> }
    else if (_shops.Count == 0) { <EmptyState Title="@L["ยังไม่มีร้าน", "No shops yet"]" Icon="@Icons.Material.Outlined.Store" /> }
    else
    {
        @foreach (var s in _shops)
        {
            <MudPaper Outlined="true" Class="pa-3 mb-2 ss-card">
                <div class="d-flex align-center gap-2">
                    @if (s.LogoUrl is not null) { <MudAvatar><MudImage Src="@s.LogoUrl" /></MudAvatar> }
                    <div style="flex:1; min-width:0">
                        <MudLink Href="@($"/shops/{s.Id}")" Typo="Typo.subtitle1" Class="d-block ss-ellipsis" Style="font-weight:600">@s.Name</MudLink>
                        <MudText Typo="Typo.caption" Class="ss-muted d-block">
                            <span class="ss-nowrap">@L["รหัส", "Code"] @s.Code</span> · <span class="ss-nowrap">@s.MemberCount @L["สมาชิกร้าน", "team"]</span>
                            @if (s.RatingCount > 0) { <span class="ss-nowrap"> · ⭐ @s.RatingAverage.ToString("0.0") (@s.RatingCount)</span> }
                        </MudText>
                    </div>
                    <StatusBadge Status="s.Status" />
                </div>
                @if (s.Lifecycle == "Suspended")
                {
                    <div class="ss-suspended-box mt-2">
                        @if (!string.IsNullOrWhiteSpace(s.SuspendReason)) { <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">⛔ @s.SuspendReason</MudText> }
                        <MudSwitch T="bool" Value="s.VisibleWhileSuspended" ValueChanged="@(v => SetVisibleAsync(s, v))" Color="Color.Primary" Class="ma-0">
                            <MudText Typo="Typo.body2">@L["ลูกค้ายังเห็นร้าน (สั่งซื้อไม่ได้)", "Customers can still see the shop (no ordering)"]</MudText>
                        </MudSwitch>
                        <div class="d-flex justify-end">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => ReinstateAsync(s))">@L["คืนสถานะร้าน", "Reinstate"]</MudButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-end mt-1">
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => SuspendAsync(s))">@L["ระงับร้าน", "Suspend"]</MudButton>
                    </div>
                }
            </MudPaper>
        }
    }
</div>

@code {
    private List<AdminShopRow>? _shops;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _shops = await Api.Get<List<AdminShopRow>>("api/plant/admin/shops") ?? [];

    private async Task SuspendAsync(AdminShopRow s)
    {
        var result = await (await Dialogs.ShowAsync<SuspendShopDialog>(L["ระงับร้าน", "Suspend"] + " " + s.Name)).Result;
        if (result is { Canceled: false, Data: SuspendShopResult r }
            && await Api.Post($"api/plant/admin/shops/{s.Id}/suspend", new { reason = r.Reason, visible = r.Visible }))
            await LoadAsync();
    }

    private async Task SetVisibleAsync(AdminShopRow s, bool visible)
    {
        if (await Api.Put($"api/plant/admin/shops/{s.Id}/suspension-visibility", new { visible })) await LoadAsync();
    }

    private async Task ReinstateAsync(AdminShopRow s)
    {
        if (await Api.Post($"api/plant/admin/shops/{s.Id}/reinstate", new { })) await LoadAsync();
    }
}
