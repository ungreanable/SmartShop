@page "/system"
@layout BareLayout
@inject Api Api
@inject PlantContext Plant
@inject NavigationManager Nav

<AppGuard RequirePlant="false" RequireSystemAdmin="true">
    <div class="d-flex align-center mb-3">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/villages" />
        <MudText Typo="Typo.h5" Style="font-weight:700">@L["ผู้ดูแลระบบ: หมู่บ้าน", "System admin: villages"]</MudText>
    </div>
    @foreach (var p in _plants)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2 ss-card">
            <MudText Typo="Typo.subtitle1">@p.Name</MudText>
            <MudText Typo="Typo.caption" Class="ss-muted">@L["โค้ด", "Code"] @p.JoinCode · @p.ActiveMembers @L["สมาชิก", "members"] · @p.PendingMembers @L["รออนุมัติ", "pending"] · @p.TimeZoneId</MudText>
        </MudPaper>
    }
    <MudPaper Outlined="true" Class="pa-3 mt-3 ss-card">
        <MudText Typo="Typo.subtitle1" Style="font-weight:600">@L["สร้างหมู่บ้านใหม่", "Create a village"]</MudText>
        <MudTextField @bind-Value="_name" Label="@L["ชื่อหมู่บ้าน", "Village name"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
        <MudText Typo="Typo.caption" Class="ss-muted">@L["คุณจะเป็นผู้ดูแลหมู่บ้านคนแรก แต่งตั้งคนอื่นเพิ่มได้ภายหลัง", "You become the first village admin and can appoint others later."]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="@string.IsNullOrWhiteSpace(_name)" OnClick="CreateAsync">@L["สร้าง", "Create"]</MudButton>
    </MudPaper>
</AppGuard>

@code {
    private List<PlantSummary> _plants = [];
    private string? _name;

    protected override async Task OnInitializedAsync() => _plants = await Api.Get<List<PlantSummary>>("api/admin/plants") ?? [];

    private async Task CreateAsync()
    {
        var plant = await Api.Post<PlantSummary>("api/admin/plants", new { name = _name, timeZoneId = "Asia/Bangkok" });
        if (plant is null) return;
        await Plant.LoadAsync(force: true);
        await Plant.SelectAsync(plant.Id);
        Nav.NavigateTo("/admin");
    }
}
